# Secrets and local environment
.env
.env.*
!.env.example
!web/admin/.env
!web/admin/.env.*

# Go build and test output
*.exe
*.exe~
*.test
*.out
coverage.out
coverage.*
/bin/

# Node and frontend dependencies
node_modules/
/docs/.vitepress/cache/
/docs/.vitepress/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
*.tsbuildinfo

# Frontend build output
/dist/
/web/admin/dist/

# Generated assets embedded by Go; keep a placeholder so `go build` works.
/internal/console/dist/*
!internal/console/dist/.gitkeep

# Local caches and debug workspaces
/data/
/tmp/
/debug/
/.cache/
/.pnpm-store/
.VSCodeCounter/
.codegraph/

# Soybean template-local files that Omniflux does not need in VCS
/web/admin/.vite-hooks/
/web/admin/.github/
/web/admin/docs/

# Logs
logs/
*.log

# Coverage
coverage/
*.lcov
.nyc_output/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Package managers we do not use for the admin app
web/admin/package-lock.json
web/admin/yarn.lock

# Cypress local artifacts
cypress/screenshots/
cypress/videos/
# Frontend environment files that are safe to commit
!web/admin/.env
!web/admin/.env.prod
!web/admin/.env.test

# Project-local agent workspace
/.codex/

# Local agent workflow rules
/AGENTS.md

# Local unpublished architecture notes
/docs/architecture/Omniflux-项目构想与架构设计.md
