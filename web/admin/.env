# the base url of the application, Omniflux is mounted under /admin/
VITE_BASE_URL=/admin/

VITE_APP_TITLE=Omniflux Admin

VITE_APP_DESC=Enterprise AI gateway and governance console

# the prefix of the icon name
VITE_ICON_PREFIX=icon

# the prefix of the local svg icon component, must include VITE_ICON_PREFIX
VITE_ICON_LOCAL_PREFIX=icon-local

# auth route mode: static | dynamic
VITE_AUTH_ROUTE_MODE=static

# static auth route home
VITE_ROUTE_HOME=home

# default menu icon
VITE_MENU_ICON=mdi:menu

# whether to enable http proxy when is dev mode
VITE_HTTP_PROXY=Y

# vue-router mode: history
VITE_ROUTER_HISTORY_MODE=history

# success code of Omniflux admin API
VITE_SERVICE_SUCCESS_CODE=0000

# logout codes of Omniflux admin API
VITE_SERVICE_LOGOUT_CODES=AUTH_EXPIRED

# modal logout codes of Omniflux admin API
VITE_SERVICE_MODAL_LOGOUT_CODES=

# token expired codes; browser cookie sessions do not use refresh tokens
VITE_SERVICE_EXPIRED_TOKEN_CODES=

# sourcemap
VITE_SOURCE_MAP=N

# Used to differentiate storage across different domains
VITE_STORAGE_PREFIX=OMNIFLUX_

# used to control whether the program automatically detects updates
VITE_AUTOMATICALLY_DETECT_UPDATE=N

# show proxy url log in terminal
VITE_PROXY_LOG=Y

# used to control whether to launch editor
VITE_DEVTOOLS_LAUNCH_EDITOR=code
